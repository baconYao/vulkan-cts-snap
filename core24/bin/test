#!/bin/bash

# When invoked directly (bypassing the snap launcher), SNAP is not set.
# Derive it from this script's own location: test lives at $SNAP/test.
SNAP="${SNAP:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")}"

NO_CONFINEMENT=false
DEQP_ARGS=()
LOG_FILENAME="TestResults.qpa"
HAS_TESTSPEC=false

for arg in "$@"; do
    case "$arg" in
        --no-confinement)
            NO_CONFINEMENT=true
            ;;
        --caselist=*)
            CASELIST_PATH="${arg#--caselist=}"
            DEQP_ARGS+=(--deqp-caselist-file="${SNAP}/usr/share/vulkan-cts/${CASELIST_PATH}")
            LOG_FILENAME="$(basename "${CASELIST_PATH}" .txt).qpa"
            HAS_TESTSPEC=true
            ;;
        --deqp-case=*)
            DEQP_ARGS+=("$arg")
            HAS_TESTSPEC=true
            ;;
        -*)
            DEQP_ARGS+=("$arg")
            ;;
        *)
            if [ "$HAS_TESTSPEC" = false ]; then
                DEQP_ARGS+=(--deqp-case="$arg")
                HAS_TESTSPEC=true
            else
                DEQP_ARGS+=("$arg")
            fi
            ;;
    esac
done

if [ "$HAS_TESTSPEC" = false ]; then
    echo "Usage: baconyao-vulkan-cts-24.test [--no-confinement] <test-spec> [args passed to deqp-vk]"
    echo ""
    echo "  <test-spec> is one of:"
    echo "    --deqp-case=<pattern>   Run tests matching a case name or glob patterni from caselist files"
    echo "                            (e.g. dEQP-VK.info.* or dEQP-VK.info.build)"
    echo "    --caselist=<path>       Run all tests listed in a caselist file."
    echo "                            Use a path as shown by 'baconyao-vulkan-cts-24.list-tests'."
    echo "    <pattern>               Shorthand for --deqp-case=<pattern>"
    echo ""
    echo "  --no-confinement          Skip snap-bundled GPU/Vulkan drivers and use host"
    echo "                            drivers exclusively. Intended for use with the"
    echo "                            Checkbox framework when snap sandboxing is removed."
    echo ""
    echo "  Any additional options are passed directly to deqp-vk (the underlying"
    echo "  Vulkan CTS runner). Run 'deqp-vk --help' inside the snap for the full list."
    echo ""
    echo "Examples:"
    echo "  baconyao-vulkan-cts-24.test dEQP-VK.info.build"
    echo "  baconyao-vulkan-cts-24.test --deqp-case=dEQP-VK.info.*"
    echo "  baconyao-vulkan-cts-24.test --caselist=mustpass/main/vk-default/api.txt"
    exit 1
fi

ARCH="${SNAP_ARCH:-$(dpkg --print-architecture)}"
case "$ARCH" in
    amd64) ARCH_TRIPLE=x86_64-linux-gnu ;;
    arm64) ARCH_TRIPLE=aarch64-linux-gnu ;;
    *)     ARCH_TRIPLE="${ARCH}-linux-gnu" ;;
esac

if [ "$NO_CONFINEMENT" = "true" ]; then
    # Use host drivers exclusively.
    # LD_PRELOAD overrides DT_RPATH embedded by snapcraft's patchelf pass.
    # LD_LIBRARY_PATH covers the rest of the host driver stack.
    # Snap layout mounts are absent when Checkbox strips sandboxing, so
    # the host's Vulkan ICD loader finds ICDs from /usr/share/vulkan/icd.d/ automatically.
    HOST_VK="/usr/lib/${ARCH_TRIPLE}/libvulkan.so.1"
    if [ ! -f "$HOST_VK" ]; then
        echo "Error: --no-confinement requires the host Vulkan loader at $HOST_VK"
        echo "Install libvulkan1 (or equivalent) on the host before using this mode."
        exit 1
    fi
    # libwayland-client must also be preloaded: the host's Vulkan ICD
    # (libvulkan_intel.so etc.) uses symbols (e.g. wl_fixes_interface) absent
    # from the older libwayland bundled in the snap.
    HOST_WL="/usr/lib/${ARCH_TRIPLE}/libwayland-client.so.0"
    export LD_PRELOAD="${HOST_WL}:${HOST_VK}"
    export LD_LIBRARY_PATH="/usr/lib/${ARCH_TRIPLE}:/usr/lib"
    echo "Host Vulkan loader: ${HOST_VK}"
else
    # Set up Vulkan ICD and libraries from gpu-2404 content interface
    if [ -d "${SNAP}/gpu-2404" ]; then
        CONTENT_DIR="${SNAP}/gpu-2404"
        VK_ICD_FILENAMES=$(ls "${CONTENT_DIR}/usr/share/vulkan/icd.d/"*.json 2>/dev/null | tr '\n' ':')
        if [ -z "$VK_ICD_FILENAMES" ]; then
            # Some vendor drivers (e.g. Arm Mali) ship a standard Khronos
            # libvulkan.so.1 loader plus a driver library (libmali.so) that
            # implements the vk_icd* ABI directly, but no ICD manifest JSON
            # at all. Without a manifest the loader reports "Found no
            # drivers" (VK_ERROR_INCOMPATIBLE_DRIVER) even though the
            # driver library is present. Generate a manifest on the fly.
            for candidate in "${CONTENT_DIR}/lib/libmali.so" "${CONTENT_DIR}/lib"/libmali.so.*; do
                if [ -e "$candidate" ]; then
                    GENERATED_ICD_DIR="${XDG_RUNTIME_DIR:-${SNAP_USER_COMMON:-/tmp}}"
                    mkdir -p "${GENERATED_ICD_DIR}"
                    GENERATED_ICD="${GENERATED_ICD_DIR}/vulkan-cts-generated-icd.json"
                    cat > "${GENERATED_ICD}" <<EOF
{
    "file_format_version": "1.0.0",
    "ICD": {
        "library_path": "${candidate}",
        "api_version": "1.3.0"
    }
}
EOF
                    VK_ICD_FILENAMES="${GENERATED_ICD}"
                    break
                fi
            done
        fi
        # Only export if manifests exist: an empty VK_ICD_FILENAMES makes
        # the standard loader report zero ICDs (VK_ERROR_INCOMPATIBLE_DRIVER)
        # instead of just being ignored.
        [ -n "$VK_ICD_FILENAMES" ] && export VK_ICD_FILENAMES
        # Prepend the content interface's lib dir so the vendor's Vulkan
        # library takes precedence over this snap's own bundled Vulkan
        # loader (libvulkan1, staged under $SNAP/usr/lib) which is already
        # earlier in LD_LIBRARY_PATH at this point and would otherwise win.
        export LD_LIBRARY_PATH="${CONTENT_DIR}/lib:${CONTENT_DIR}/usr/lib/${ARCH_TRIPLE}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    else
        echo "Error: gpu-2404 content interface not found at ${SNAP}/gpu-2404"
        echo "Connect it with: snap connect baconyao-vulkan-cts-24:gpu-2404 mesa-2404:gpu-2404"
        exit 1
    fi
fi

# Create a working directory for test results
WORK_DIR="${HOME}/.vulkan-cts"
mkdir -p "${WORK_DIR}"

# deqp resolves data paths relative to CWD, so run from the data root.
cd "${SNAP}/usr/share/vulkan-cts"

exec "${SNAP}/usr/bin/deqp-vk" \
    "${DEQP_ARGS[@]}" \
    --deqp-log-filename="${WORK_DIR}/${LOG_FILENAME}"
